# 🌟 使用 wss 协议，并指向你的加速域名
VITE_CHAT_WS=wss://chengzishaoxia.top/ws/chat

# 🌟 统一使用 wss
VITE_APP_WS_ENDPOINT=wss://chengzishaoxia.top/ws

# 部署子路径保持根路径
VITE_APP_PUBLIC_PATH=/

# 🌟 后端 API 改为 https，由 Nginx/CDN 处理转发
VITE_APP_API_URL=https://chengzishaoxia.top

# 前端请求使用的统一前缀
VITE_APP_BASE_API=/api

VITE_APP_TOKEN_COOKIE_NAME=satoken

# 配置页签标题
VITE_APP_TITLE = "橙子的小屋"